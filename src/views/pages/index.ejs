<!-- Những bài hát thịnh hành -->
<section>
    <header class="section-heading-wrapper">
        <h2 class="section-heading">Những bài hát thịnh hành</h2>
        <div class="view-all-link skeleton skeleton-title"></div>
    </header>
    <div id="slidezy-trending">
        <% for (let i = 0; i < 8; i++) { %>
        <div class="card card-skeleton">
            <div class="card__img-wrap skeleton"></div>
            <div class="card__content">
                <div class="card__title skeleton skeleton-title"></div>
                <p class="card__desc skeleton skeleton-line"></p>
            </div>
        </div>
        <% } %>
    </div>
</section>

<!-- Nghệ sĩ phổ biến -->
<section class="section-home">
    <header class="section-heading-wrapper">
        <h2 class="section-heading">Nghệ sĩ phổ biến</h2>
        <div class="view-all-link skeleton skeleton-title"></div>
    </header>
    <div id="slidezy-artists">
        <% for (let i = 0; i < 8; i++) { %>
        <article class="card card-skeleton">
            <div class="card__img-wrap card__thumbnail--circle skeleton"></div>
            <div class="card__content">
                <h3 class="card__title skeleton skeleton-title"></h3>
                <p class="card__desc skeleton skeleton-line"></p>
            </div>
        </article>
        <% } %>
    </div>
</section>

<!-- Album và đĩa đơn nổi tiếng -->
<section class="section-home">
    <header class="section-heading-wrapper">
        <h2 class="section-heading">Album và đĩa đơn nổi tiếng</h2>
        <div class="view-all-link skeleton skeleton-title"></div>
    </header>
    <div id="slidezy-albums">
        <% for (let i = 0; i < 8; i++) { %>
        <div class="card card-skeleton">
            <div class="card__img-wrap skeleton"></div>
            <div class="card__content">
                <div class="card__title skeleton skeleton-title"></div>
                <p class="card__desc skeleton skeleton-line"></p>
            </div>
        </div>
        <% } %>
    </div>
</section>