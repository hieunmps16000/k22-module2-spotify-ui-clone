<!-- Những bài hát thịnh hành -->
<section id="trending-songs">
    <div class="container-fluid">
        <header class="section-heading-wrapper">
            <h2 class="section-heading">Những bài hát thịnh hành</h2>
        </header>
        <div class="trending-tracks" aria-busy="true">
            <div class="row row-cols-6 row-cols-xl-5 row-cols-lg-4 row-cols-md-3 row-cols-sm-2" data-home-trending-tracks>
                <% for (let i = 0; i < 20; i++) { %>
                <div class="col">
                    <div class="card card-skeleton">
                        <div class="card__img-wrap skeleton"></div>
                        <div class="card__content">
                            <div class="card__title skeleton skeleton-title"></div>
                            <p class="card__desc skeleton skeleton-line"></p>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<!-- Nghệ sĩ phổ biến -->
<section class="section-home">
    <div class="container-fluid">
        <header class="section-heading-wrapper">
            <h2 class="section-heading">Nghệ sĩ phổ biến</h2>
        </header>
        <div class="popular-artists">
            <div class="row row-cols-5 row-cols-lg-4 row-cols-md-3 row-cols-sm-2" data-home-popular-artists>
                <% for (let i = 0; i < 8; i++) { %>
                <div class="col">
                    <article class="card card-skeleton">
                        <div class="card__img-wrap card__thumbnail--circle skeleton"></div>
                        <div class="card__content">
                            <h3 class="card__title skeleton skeleton-title"></h3>
                            <p class="card__desc skeleton skeleton-line"></p>
                        </div>
                    </article>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<!-- Album và đĩa đơn nổi tiếng -->
<section class="section-home">
    <div class="container-fluid">
        <header class="section-heading-wrapper">
            <h2 class="section-heading">Album và đĩa đơn nổi tiếng</h2>
        </header>
        <div id="slidezy-albums">
            <div class="row row-cols-5 row-cols-lg-4 row-cols-md-3 row-cols-sm-2" data-home-famous-albums>
                <% for (let i = 0; i < 8; i++) { %>
                <div class="col">
                    <div class="card card-skeleton">
                        <div class="card__img-wrap skeleton"></div>
                        <div class="card__content">
                            <div class="card__title skeleton skeleton-title"></div>
                            <p class="card__desc skeleton skeleton-line"></p>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>